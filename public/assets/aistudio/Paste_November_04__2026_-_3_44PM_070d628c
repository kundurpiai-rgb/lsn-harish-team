      <div class="flex gap-2">
        <button onclick="saveSupabaseConfig()" class="flex-1 py-3 bg-sky-600 hover:bg-sky-500 text-white font-bold rounded-xl text-xs transition shadow-lg shadow-sky-600/20">
          Save Credentials & Connect
