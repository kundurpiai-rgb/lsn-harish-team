<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FleetGuard 360 - Daily Rider & Vehicle Inspection</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f9ff',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              900: '#0c4a6e',
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Supabase JS Client SDK -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    /* Custom CSS Enhancements */
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }
    .video-mirror {
      transform: scaleX(-1);
    }
    /* Hide scrollbars for clean UI */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased">

  <!-- TOP HEADER / NAVBAR -->
  <header class="border-b border-slate-800 bg-slate-900/90 sticky top-0 z-40 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 py-3.5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <div class="p-2.5 bg-gradient-to-tr from-sky-600 to-indigo-600 rounded-xl shadow-lg shadow-sky-500/20">
          <i data-lucide="bike" class="w-6 h-6 text-white"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-lg font-black tracking-tight text-white">
              FleetGuard <span class="text-sky-400 font-light">360</span>
            </h1>
            <span id="connectionBadge" class="text-[10px] bg-amber-500/20 text-amber-300 font-mono font-semibold px-2 py-0.5 rounded-full border border-amber-500/30">
              Demo Mode (Config Required)
            </span>
          </div>
          <p class="text-xs text-slate-400">Daily Rider Inspection & Vehicle Tracking System</p>
        </div>
      </div>

      <!-- Navigation & Setup Buttons -->
      <div class="flex items-center space-x-2 w-full sm:w-auto">
        <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800 shadow-inner flex-1 sm:flex-none">
          <button id="tabRiderBtn" onclick="switchTab('rider')" class="flex-1 sm:flex-none flex items-center justify-center space-x-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-sky-600 text-white transition-all shadow-md">
            <i data-lucide="camera" class="w-3.5 h-3.5"></i>
            <span>Rider Check-in</span>
          </button>
          <button id="tabTlBtn" onclick="switchTab('tl')" class="flex-1 sm:flex-none flex items-center justify-center space-x-1.5 px-4 py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all">
            <i data-lucide="users" class="w-3.5 h-3.5"></i>
            <span>TL Ops Portal</span>
          </button>
        </div>

        <button onclick="openConfigModal()" class="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl border border-slate-700 transition" title="Supabase API Setup">
          <i data-lucide="settings" class="w-4 h-4"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full">

    <!-- ========================================================================= -->
    <!-- MODULE 1: RIDER DAILY INSPECTION FORM (MOBILE FIRST)                       -->
    <!-- ========================================================================= -->
    <section id="riderSection" class="max-w-xl mx-auto space-y-4">
      
      <!-- SUCCESS CONTAINER (HIDDEN INITIALLY) -->
      <div id="riderSuccessCard" class="hidden bg-slate-900/90 border border-emerald-500/30 rounded-3xl p-6 text-center shadow-2xl space-y-5">
        <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto ring-8 ring-emerald-500/10">
          <i data-lucide="check-circle-2" class="w-10 h-10"></i>
        </div>
        <div>
          <h2 class="text-xl font-bold text-white">Daily Inspection Submitted!</h2>
          <p id="successRiderSubtext" class="text-slate-400 text-xs mt-1">Vehicle data logged to fleet operations.</p>
        </div>
        <div class="p-4 bg-slate-950/80 rounded-2xl text-left border border-slate-800 space-y-2 text-xs font-mono">
          <div class="flex justify-between border-b border-slate-800 pb-2">
            <span class="text-slate-500">STATUS:</span>
            <span id="successStatusVal" class="font-bold text-emerald-400">Working/Active</span>
          </div>
          <div id="successReasonRow" class="hidden flex justify-between border-b border-slate-800 pb-2">
            <span class="text-slate-500">REASON:</span>
            <span id="successReasonVal" class="text-amber-300 font-bold">--</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">PHOTOS VERIFIED:</span>
            <span class="text-emerald-400 font-bold">5 of 5 Live Snaps ✓</span>
          </div>
        </div>
        <button onclick="resetRiderForm()" class="w-full py-3.5 bg-sky-600 hover:bg-sky-500 text-white font-bold rounded-2xl transition shadow-xl text-xs uppercase tracking-wider">
          Start New Inspection
        </button>
      </div>

      <!-- MAIN FORM CONTAINER -->
      <div id="riderFormCard" class="bg-slate-900/80 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden backdrop-blur-md">
        
        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 p-4 border-b border-slate-800 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="p-2 bg-sky-500/10 border border-sky-500/30 rounded-xl text-sky-400">
              <i data-lucide="shield-check" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="font-bold text-white text-sm">Daily Vehicle Inspection</h2>
              <p class="text-[11px] text-slate-400">Camera-only live verification</p>
            </div>
          </div>
          <span class="text-[10px] bg-slate-800 text-slate-300 font-mono px-3 py-1 rounded-full border border-slate-700">
            5 Photos Required
          </span>
        </div>

        <form id="riderInspectionForm" onsubmit="handleInspectionSubmit(event)" class="p-5 space-y-6">
          
          <!-- STEP 1: PHONE LOOKUP / RIDER MAPPING -->
          <div class="space-y-3">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">
              1. Rider Verification & Lookup
            </label>
            <div class="relative">
              <i data-lucide="phone" class="w-4 h-4 text-slate-500 absolute left-3.5 top-3.5"></i>
              <input
                type="tel"
                id="riderPhoneInput"
                placeholder="Enter 10-digit registered phone number..."
                oninput="lookupRiderByPhone(this.value)"
                class="w-full pl-10 pr-4 py-3 bg-slate-950 border border-slate-800 rounded-2xl text-white text-xs focus:outline-none focus:border-sky-500 transition font-mono"
                required
              />
            </div>

            <!-- Mapped Rider Details Card -->
            <div id="riderBadge" class="hidden p-3.5 bg-emerald-950/40 border border-emerald-500/30 rounded-2xl flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">
                  <i data-lucide="user" class="w-5 h-5"></i>
                </div>
                <div>
                  <div id="badgeRiderName" class="text-sm font-bold text-white">--</div>
                  <div id="badgeVehicleDetails" class="text-xs text-emerald-400 font-mono font-semibold">--</div>
                </div>
              </div>
              <span class="text-[10px] font-bold bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full border border-emerald-500/30">
                Mapped ✓
              </span>
            </div>

            <!-- Rider Unmapped Warning -->
            <div id="riderNotFoundWarn" class="hidden p-3 bg-amber-950/30 border border-amber-500/30 rounded-2xl text-amber-300 text-xs flex items-center space-x-2">
              <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0"></i>
              <span>Rider phone not found. Ask Team Lead (TL) to deploy/map your phone first.</span>
            </div>
          </div>

          <!-- STEP 2: DAILY VEHICLE STATUS & REASON -->
          <div id="step2Container" class="space-y-4 pt-4 border-t border-slate-800 opacity-50 pointer-events-none transition-all">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">
              2. Vehicle Operational Status
            </label>

            <div class="grid grid-cols-2 gap-2.5">
              <button type="button" onclick="setStatus('Working/Active')" id="statusBtn_Working" class="p-3.5 rounded-2xl border text-left flex items-start space-x-3 bg-sky-600/20 border-sky-500 text-white shadow-lg transition">
                <i data-lucide="activity" class="w-5 h-5 text-sky-400 shrink-0"></i>
                <div class="text-xs font-bold">Active / Working</div>
              </button>
              <button type="button" onclick="setStatus('Breakdown')" id="statusBtn_Breakdown" class="p-3.5 rounded-2xl border border-slate-800 bg-slate-950 text-slate-400 hover:border-slate-700 text-left flex items-start space-x-3 transition">
                <i data-lucide="alert-triangle" class="w-5 h-5 text-slate-500 shrink-0"></i>
                <div class="text-xs font-bold">Breakdown / Issue</div>
              </button>
              <button type="button" onclick="setStatus('Servicing')" id="statusBtn_Servicing" class="p-3.5 rounded-2xl border border-slate-800 bg-slate-950 text-slate-400 hover:border-slate-700 text-left flex items-start space-x-3 transition">
                <i data-lucide="wrench" class="w-5 h-5 text-slate-500 shrink-0"></i>
                <div class="text-xs font-bold">In Servicing</div>
              </button>
              <button type="button" onclick="setStatus('Returned/Idle')" id="statusBtn_Returned" class="p-3.5 rounded-2xl border border-slate-800 bg-slate-950 text-slate-400 hover:border-slate-700 text-left flex items-start space-x-3 transition">
                <i data-lucide="rotate-ccw" class="w-5 h-5 text-slate-500 shrink-0"></i>
                <div class="text-xs font-bold">Returned / Idle</div>
              </button>
            </div>

            <!-- DYNAMIC RETURN/BREAKDOWN REASON DROPDOWN -->
            <div id="reasonDropdownContainer" class="hidden p-4 bg-amber-950/20 border border-amber-500/30 rounded-2xl space-y-3">
              <label class="block text-xs font-bold text-amber-300">
                Specify Reason for Non-Active Status:
              </label>
              <select id="returnReasonSelect" onchange="handleReasonSelectChange(this.value)" class="w-full p-3 bg-slate-950 border border-amber-500/40 rounded-xl text-white text-xs focus:outline-none">
                <option value="">-- Choose Mandatory Reason --</option>
                <option value="Engine Failure / Motor Issue">Engine Failure / Motor Issue</option>
                <option value="Flat Tyre / Wheel Puncture">Flat Tyre / Wheel Puncture</option>
                <option value="Brake Cable / Pad Failure">Brake Cable / Pad Failure</option>
                <option value="Battery Drain / Charging Failure">Battery Drain / Charging Failure</option>
                <option value="Accidental Damage">Accidental Damage</option>
                <option value="Shift Ended - Parked at Hub">Shift Ended - Parked at Hub</option>
                <option value="Rider Off-Duty / Leave">Rider Off-Duty / Leave</option>
                <option value="Periodic Scheduled Servicing">Periodic Scheduled Servicing</option>
                <option value="Other Reason">Other Reason...</option>
              </select>

              <textarea id="customReasonText" placeholder="Please describe exact reason..." class="hidden w-full p-3 bg-slate-950 border border-amber-500/40 rounded-xl text-white text-xs focus:outline-none" rows="2"></textarea>
            </div>
          </div>

          <!-- STEP 3: STRICT CAMERA-ONLY 5 PHOTO CAPTURE -->
          <div id="step3Container" class="space-y-4 pt-4 border-t border-slate-800 opacity-50 pointer-events-none transition-all">
            <div class="flex items-center justify-between">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">
                  3. Live Camera Photo Verification
                </label>
                <p class="text-[11px] text-amber-400 font-mono flex items-center space-x-1 mt-0.5">
                  <span>🚫 Storage upload blocked. Camera feed only.</span>
                </p>
              </div>
              <span id="photoCountBadge" class="text-xs font-mono font-bold text-sky-400 bg-sky-500/10 px-2.5 py-1 rounded-full border border-sky-500/20">
                0 / 5 Snaps
              </span>
            </div>

            <!-- 5 STEP PHOTO PROGRESS THUMBNAILS -->
            <div class="grid grid-cols-5 gap-2">
              <button type="button" onclick="selectStepIndex(0)" id="photoThumb_0" class="relative aspect-square rounded-xl border border-sky-500 bg-sky-950/50 flex flex-col items-center justify-center p-1 text-center transition-all overflow-hidden ring-2 ring-sky-500/40">
                <i data-lucide="camera" class="w-4 h-4 text-sky-400"></i>
                <span class="text-[9px] font-semibold mt-1 text-slate-300 truncate w-full">1. Selfie</span>
              </button>
              <button type="button" onclick="selectStepIndex(1)" id="photoThumb_1" class="relative aspect-square rounded-xl border border-slate-800 bg-slate-950 opacity-50 flex flex-col items-center justify-center p-1 text-center transition-all overflow-hidden">
                <i data-lucide="camera" class="w-4 h-4 text-slate-500"></i>
                <span class="text-[9px] font-semibold mt-1 text-slate-400 truncate w-full">2. Front</span>
              </button>
              <button type="button" onclick="selectStepIndex(2)" id="photoThumb_2" class="relative aspect-square rounded-xl border border-slate-800 bg-slate-950 opacity-50 flex flex-col items-center justify-center p-1 text-center transition-all overflow-hidden">
                <i data-lucide="camera" class="w-4 h-4 text-slate-500"></i>
                <span class="text-[9px] font-semibold mt-1 text-slate-400 truncate w-full">3. Back</span>
              </button>
              <button type="button" onclick="selectStepIndex(3)" id="photoThumb_3" class="relative aspect-square rounded-xl border border-slate-800 bg-slate-950 opacity-50 flex flex-col items-center justify-center p-1 text-center transition-all overflow-hidden">
                <i data-lucide="camera" class="w-4 h-4 text-slate-500"></i>
                <span class="text-[9px] font-semibold mt-1 text-slate-400 truncate w-full">4. Left</span>
              </button>
              <button type="button" onclick="selectStepIndex(4)" id="photoThumb_4" class="relative aspect-square rounded-xl border border-slate-800 bg-slate-950 opacity-50 flex flex-col items-center justify-center p-1 text-center transition-all overflow-hidden">
                <i data-lucide="camera" class="w-4 h-4 text-slate-500"></i>
                <span class="text-[9px] font-semibold mt-1 text-slate-400 truncate w-full">5. Right</span>
              </button>
            </div>

            <!-- LIVE WEBRTC CAMERA DISPLAY BOX -->
            <div class="p-4 bg-slate-950 border border-slate-800 rounded-2xl space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-white">
                  Current Angle: <span id="currentStepTitle" class="text-sky-400">1. Rider Live Selfie</span>
                </span>
                <span id="currentStepDesc" class="text-[10px] text-slate-400">Take face photo standing next to vehicle</span>
              </div>

              <!-- Camera Viewport Canvas/Video -->
              <div class="relative aspect-video bg-black rounded-2xl overflow-hidden border border-slate-800 flex items-center justify-center">
                <!-- WebRTC Live Stream Video -->
                <video id="webcamVideo" autoplay playsinline muted class="w-full h-full object-cover hidden"></video>

                <!-- Captured Static Image Preview -->
                <img id="capturedImgPreview" src="" alt="Captured angle preview" class="w-full h-full object-cover hidden" />

                <!-- Placeholder Screen when Camera Inactive -->
                <div id="cameraPlaceholder" class="text-center space-y-2 p-6">
                  <i data-lucide="camera" class="w-10 h-10 text-slate-600 mx-auto"></i>
                  <p class="text-xs text-slate-400">Tap below to activate device live camera stream</p>
                </div>

                <!-- Viewfinder Target Box Overlay -->
                <div id="cameraOverlay" class="hidden absolute inset-0 border-2 border-dashed border-sky-400/50 pointer-events-none rounded-2xl m-3 flex items-center justify-center">
                  <span id="overlayLabel" class="text-white text-[10px] font-mono bg-slate-950/80 px-3 py-1 rounded-full backdrop-blur">
                    ALIGN: Rider Face & Bike
                  </span>
                </div>
              </div>

              <!-- Hidden Canvas for Watermarking Canvas Snapshots -->
              <canvas id="snapshotCanvas" class="hidden"></canvas>

              <!-- Camera Trigger Actions -->
              <div class="flex gap-2">
                <button type="button" id="startCamBtn" onclick="startCameraStream()" class="flex-1 py-3 bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold rounded-xl flex items-center justify-center space-x-2 transition shadow-lg shadow-sky-600/20">
                  <i data-lucide="camera" class="w-4 h-4"></i>
                  <span id="startCamBtnText">Activate Camera</span>
                </button>

                <button type="button" id="snapCamBtn" onclick="takePhotoSnapshot()" class="hidden flex-1 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black rounded-xl flex items-center justify-center space-x-2 shadow-xl shadow-emerald-600/30 transition animate-pulse">
                  <i data-lucide="camera" class="w-4 h-4"></i>
                  <span>SNAP PHOTO NOW</span>
                </button>

                <button type="button" id="flipCamBtn" onclick="toggleCameraFacing()" class="hidden px-4 py-3.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs flex items-center justify-center" title="Flip Camera">
                  <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- SUBMIT REPORT BUTTON -->
          <button
            type="submit"
            id="submitInspectionBtn"
            disabled
            class="w-full py-4 rounded-2xl font-black text-xs uppercase tracking-wider transition-all flex items-center justify-center space-x-2 shadow-2xl bg-slate-800 text-slate-500 cursor-not-allowed border border-slate-700"
          >
            <span>Submit Daily Inspection Report</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </form>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- MODULE 2: TEAM LEAD (TL) & OPERATIONS DASHBOARD                            -->
    <!-- ========================================================================= -->
    <section id="tlSection" class="hidden space-y-6">
      
      <!-- Top Metrics Bar -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="bg-slate-900/80 border border-slate-800 p-4 rounded-2xl">
          <div class="text-xs text-slate-400 font-semibold">Total Mapped Riders</div>
          <div id="statTotalRiders" class="text-2xl font-black text-white mt-1">0</div>
          <div class="text-[10px] text-sky-400 mt-1 font-mono">In Database</div>
        </div>
        <div class="bg-slate-900/80 border border-emerald-500/30 p-4 rounded-2xl">
          <div class="text-xs text-slate-400 font-semibold">Active Shifts Today</div>
          <div id="statActiveToday" class="text-2xl font-black text-emerald-400 mt-1">0</div>
          <div class="text-[10px] text-emerald-500/80 mt-1 font-mono">Working / Operational</div>
        </div>
        <div class="bg-slate-900/80 border border-rose-500/30 p-4 rounded-2xl">
          <div class="text-xs text-slate-400 font-semibold">Breakdown Alerts</div>
          <div id="statBreakdowns" class="text-2xl font-black text-rose-400 mt-1">0</div>
          <div class="text-[10px] text-rose-400/80 mt-1 font-mono">Needs Repairs</div>
        </div>
        <div class="bg-slate-900/80 border border-amber-500/30 p-4 rounded-2xl">
          <div class="text-xs text-slate-400 font-semibold">Returned / Idle</div>
          <div id="statIdle" class="text-2xl font-black text-amber-400 mt-1">0</div>
          <div class="text-[10px] text-amber-400/80 mt-1 font-mono">Parked at Hub</div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- LEFT COLUMN: ONBOARD / DEPLOY RIDER FORM -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-5 space-y-4 h-fit">
          <div class="flex items-center space-x-2 border-b border-slate-800 pb-3">
            <i data-lucide="user-plus" class="w-5 h-5 text-sky-400"></i>
            <h2 class="font-bold text-white text-sm">Onboard / Map New Rider</h2>
          </div>

          <form id="onboardRiderForm" onsubmit="handleOnboardRider(event)" class="space-y-3.5 text-xs">
            <div>
              <label class="block text-slate-300 font-semibold mb-1">Rider Full Name *</label>
              <input
                type="text"
                id="onboardName"
                placeholder="e.g. Rahul Sharma"
                class="w-full p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500"
                required
              />
            </div>

            <div>
              <label class="block text-slate-300 font-semibold mb-1">Mobile Phone Number *</label>
              <input
                type="tel"
                id="onboardPhone"
                placeholder="e.g. 9876543210"
                class="w-full p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 font-mono"
                required
              />
            </div>

            <div>
              <label class="block text-slate-300 font-semibold mb-1">Vehicle Plate / Reg # *</label>
              <input
                type="text"
                id="onboardVehicle"
                placeholder="e.g. KA-01-EQ-4521"
                class="w-full p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 uppercase font-mono"
                required
              />
            </div>

            <div>
              <label class="block text-slate-300 font-semibold mb-1">Hub Location</label>
              <select id="onboardHub" class="w-full p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white focus:outline-none">
                <option value="Indiranagar Hub">Indiranagar Hub</option>
                <option value="Koramangala Hub">Koramangala Hub</option>
                <option value="HSR Layout Hub">HSR Layout Hub</option>
                <option value="Whitefield Hub">Whitefield Hub</option>
              </select>
            </div>

            <button
              type="submit"
              class="w-full py-3 bg-sky-600 hover:bg-sky-500 text-white font-bold rounded-xl transition shadow-lg shadow-sky-600/20 text-xs flex items-center justify-center space-x-2 mt-2"
            >
              <i data-lucide="user-plus" class="w-4 h-4"></i>
              <span>Deploy Rider & Map Phone</span>
            </button>
          </form>
        </div>

        <!-- RIGHT COLUMN: ROSTER & INSPECTION AUDIT LIST -->
        <div class="lg:col-span-2 space-y-6">
          
          <!-- 1. Mapped Riders Roster -->
          <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-5 space-y-4">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
              <h3 class="text-sm font-bold text-white flex items-center space-x-2">
