  <!-- JAVASCRIPT LOGIC -->
  <script>
    // -------------------------------------------------------------------------
    // 1. GLOBAL STATE & PHOTO STEPS DEFINITION
    // -------------------------------------------------------------------------
    const PHOTO_STEPS = [
      { id: 'selfie', label: '1. Rider Live Selfie', desc: 'Take face photo standing next to vehicle', facing: 'user' },
      { id: 'front', label: '2. Bike Front View', desc: 'Capture headlight & front license plate', facing: 'environment' },
      { id: 'back', label: '3. Bike Rear View', desc: 'Capture tail light, indicator & rear plate', facing: 'environment' },
      { id: 'left', label: '4. Bike Left Side View', desc: 'Capture complete left body panel & tires', facing: 'environment' },
      { id: 'right', label: '5. Bike Right Side View', desc: 'Capture complete right body panel & motor', facing: 'environment' }
    ];

    let currentStepIndex = 0;
    let capturedPhotos = {}; // Stores base64 snapshots: { selfie: 'data:image/jpeg...', ... }
    let selectedStatus = 'Working/Active';
    let currentRider = null;
    let cameraStream = null;
    let currentFacingMode = 'user';

    // Supabase JS Client Instance
    let supabaseClient = null;

    // Demo Local Fallback Storage
    let localRiders = [
      { id: '1', rider_name: 'Rajesh Kumar', phone: '9876543210', vehicle_number: 'KA-01-EQ-4521', hub: 'Indiranagar Hub' },
      { id: '2', rider_name: 'Amit Verma', phone: '9812345678', vehicle_number: 'KA-05-EV-8890', hub: 'Koramangala Hub' },
      { id: '3', rider_name: 'Suresh Raina', phone: '9745612309', vehicle_number: 'KA-03-EV-1142', hub: 'HSR Layout Hub' }
    ];

    let localInspections = [];

    // -------------------------------------------------------------------------
    // 2. INITIALIZATION & SUPABASE CONFIG
    // -------------------------------------------------------------------------
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      initSupabaseFromStorage();
      renderRosterTable();
      renderInspectionLogs();
    });

    function initSupabaseFromStorage() {
      const savedUrl = localStorage.getItem('fleetguard_sb_url');
      const savedKey = localStorage.getItem('fleetguard_sb_key');

      if (savedUrl && savedKey) {
        document.getElementById('supabaseUrlInput').value = savedUrl;
        document.getElementById('supabaseKeyInput').value = savedKey;

        try {
          supabaseClient = supabase.createClient(savedUrl, savedKey);
          const badge = document.getElementById('connectionBadge');
          badge.textContent = "Supabase Connected ✓";
          badge.className = "text-[10px] bg-emerald-500/20 text-emerald-300 font-mono font-semibold px-2 py-0.5 rounded-full border border-emerald-500/30";
          
          // Sync existing database tables
          fetchRidersFromSupabase();
          fetchInspectionsFromSupabase();
        } catch (e) {
          console.warn("Invalid Supabase keys", e);
        }
      }
    }

    function openConfigModal() {
      document.getElementById('configModal').classList.remove('hidden');
    }

    function closeConfigModal() {
      document.getElementById('configModal').classList.add('hidden');
    }

    function saveSupabaseConfig() {
      const url = document.getElementById('supabaseUrlInput').value.trim();
      const key = document.getElementById('supabaseKeyInput').value.trim();

      if (!url || !key) {
        alert("Please provide both Supabase URL and Key.");
        return;
      }

      localStorage.setItem('fleetguard_sb_url', url);
      localStorage.setItem('fleetguard_sb_key', key);
      initSupabaseFromStorage();
      closeConfigModal();
      alert("Supabase Credentials Saved & Connected Successfully!");
    }

    // -------------------------------------------------------------------------
    // 3. TAB SWITCHER
    // -------------------------------------------------------------------------
    function switchTab(tab) {
      stopCameraStream();
      const riderSec = document.getElementById('riderSection');
      const tlSec = document.getElementById('tlSection');
      const tabRiderBtn = document.getElementById('tabRiderBtn');
      const tabTlBtn = document.getElementById('tabTlBtn');

      if (tab === 'rider') {
        riderSec.classList.remove('hidden');
        tlSec.classList.add('hidden');
        tabRiderBtn.className = "flex-1 sm:flex-none flex items-center justify-center space-x-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-sky-600 text-white transition-all shadow-md";
        tabTlBtn.className = "flex-1 sm:flex-none flex items-center justify-center space-x-1.5 px-4 py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all";
      } else {
        riderSec.classList.add('hidden');
        tlSec.classList.remove('hidden');
        tabTlBtn.className = "flex-1 sm:flex-none flex items-center justify-center space-x-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-sky-600 text-white transition-all shadow-md";
        tabRiderBtn.className = "flex-1 sm:flex-none flex items-center justify-center space-x-1.5 px-4 py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all";
        renderRosterTable();
        renderInspectionLogs();
      }
    }

    // -------------------------------------------------------------------------
    // 4. RIDER LOOKUP & STEP VALIDATION
    // -------------------------------------------------------------------------
    async function lookupRiderByPhone(phoneVal) {
      const trimmed = phoneVal.trim();
      const step2 = document.getElementById('step2Container');
      const step3 = document.getElementById('step3Container');
      const badge = document.getElementById('riderBadge');
      const warn = document.getElementById('riderNotFoundWarn');

      if (trimmed.length < 3) {
        currentRider = null;
        badge.classList.add('hidden');
        warn.classList.add('hidden');
        disableSteps();
        return;
      }

      let found = null;

      if (supabaseClient) {
        const { data } = await supabaseClient
          .from('riders')
          .select('*')
          .eq('phone', trimmed)
          .single();
        found = data;
      } else {
        found = localRiders.find(r => r.phone.includes(trimmed) || r.rider_name.toLowerCase().includes(trimmed.toLowerCase()));
      }

      if (found) {
        currentRider = found;
        document.getElementById('badgeRiderName').textContent = found.rider_name;
        document.getElementById('badgeVehicleDetails').textContent = `Vehicle: ${found.vehicle_number} • ${found.hub || 'Hub'}`;
        badge.classList.remove('hidden');
        warn.classList.add('hidden');

        step2.classList.remove('opacity-50', 'pointer-events-none');
        step3.classList.remove('opacity-50', 'pointer-events-none');
        validateSubmitButton();
      } else {
        currentRider = null;
        badge.classList.add('hidden');
        warn.classList.remove('hidden');
        disableSteps();
      }
    }

    function disableSteps() {
      document.getElementById('step2Container').classList.add('opacity-50', 'pointer-events-none');
      document.getElementById('step3Container').classList.add('opacity-50', 'pointer-events-none');
      validateSubmitButton();
    }

    function setStatus(statusVal) {
      selectedStatus = statusVal;
      const btnWorking = document.getElementById('statusBtn_Working');
      const btnBreakdown = document.getElementById('statusBtn_Breakdown');
      const btnServicing = document.getElementById('statusBtn_Servicing');
      const btnReturned = document.getElementById('statusBtn_Returned');
      const dropdown = document.getElementById('reasonDropdownContainer');

      [btnWorking, btnBreakdown, btnServicing, btnReturned].forEach(b => {
        b.className = "p-3.5 rounded-2xl border border-slate-800 bg-slate-950 text-slate-400 hover:border-slate-700 text-left flex items-start space-x-3 transition";
      });

      if (statusVal === 'Working/Active') {
        btnWorking.className = "p-3.5 rounded-2xl border border-sky-500 bg-sky-600/20 text-white shadow-lg text-left flex items-start space-x-3 transition";
        dropdown.classList.add('hidden');
      } else {
        if (statusVal === 'Breakdown') btnBreakdown.className = "p-3.5 rounded-2xl border border-rose-500 bg-rose-600/20 text-white shadow-lg text-left flex items-start space-x-3 transition";
        if (statusVal === 'Servicing') btnServicing.className = "p-3.5 rounded-2xl border border-amber-500 bg-amber-600/20 text-white shadow-lg text-left flex items-start space-x-3 transition";
        if (statusVal === 'Returned/Idle') btnReturned.className = "p-3.5 rounded-2xl border border-sky-500 bg-sky-600/20 text-white shadow-lg text-left flex items-start space-x-3 transition";
        dropdown.classList.remove('hidden');
      }

      validateSubmitButton();
    }

    function handleReasonSelectChange(val) {
      const customText = document.getElementById('customReasonText');
      if (val === 'Other Reason') {
        customText.classList.remove('hidden');
      } else {
        customText.classList.add('hidden');
      }
      validateSubmitButton();
    }

    // -------------------------------------------------------------------------
    // 5. WEBRTC LIVE CAMERA STREAM & CANVAS SNAPSHOT
    // -------------------------------------------------------------------------
    async function startCameraStream() {
      const step = PHOTO_STEPS[currentStepIndex];
      const video = document.getElementById('webcamVideo');
      const placeholder = document.getElementById('cameraPlaceholder');
      const previewImg = document.getElementById('capturedImgPreview');
      const overlay = document.getElementById('cameraOverlay');
      const startBtn = document.getElementById('startCamBtn');
      const snapBtn = document.getElementById('snapCamBtn');
      const flipBtn = document.getElementById('flipCamBtn');

      stopCameraStream();

      try {
        currentFacingMode = step.facing;
        const constraints = {
          video: { facingMode: currentFacingMode, width: { ideal: 1280 }, height: { ideal: 720 } },
          audio: false
        };

        cameraStream = await navigator.mediaDevices.getUserMedia(constraints);
        video.srcObject = cameraStream;
        video.classList.remove('hidden');
        if (currentFacingMode === 'user') {
          video.classList.add('video-mirror');
        } else {
          video.classList.remove('video-mirror');
        }

        placeholder.classList.add('hidden');
        previewImg.classList.add('hidden');
        overlay.classList.remove('hidden');

        startBtn.classList.add('hidden');
        snapBtn.classList.remove('hidden');
        flipBtn.classList.remove('hidden');

      } catch (err) {
        alert("Camera access denied or device hardware unavailable. Please allow camera permissions in browser.");
        console.error(err);
      }
    }

    function stopCameraStream() {
      if (cameraStream) {
        cameraStream.getTracks().forEach(track => track.stop());
        cameraStream = null;
      }
      document.getElementById('webcamVideo').classList.add('hidden');
      document.getElementById('cameraOverlay').classList.add('hidden');
      document.getElementById('startCamBtn').classList.remove('hidden');
      document.getElementById('snapCamBtn').classList.add('hidden');
      document.getElementById('flipCamBtn').classList.add('hidden');
    }

    function toggleCameraFacing() {
      currentFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
      startCameraStream();
    }

    function takePhotoSnapshot() {
      const step = PHOTO_STEPS[currentStepIndex];
      const video = document.getElementById('webcamVideo');
      const canvas = document.getElementById('snapshotCanvas');

      canvas.width = video.videoWidth || 800;
      canvas.height = video.videoHeight || 600;
      const ctx = canvas.getContext('2d');

      // Mirror selfie if front facing
      if (currentFacingMode === 'user') {
        ctx.translate(canvas.width, 0);
        ctx.scale(-1, 1);
      }

      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

      // Reset matrix for watermark
      ctx.setTransform(1, 0, 0, 1, 0, 0);

      // Stamp dynamic watermark
      ctx.fillStyle = 'rgba(15, 23, 42, 0.8)';
      ctx.fillRect(0, canvas.height - 40, canvas.width, 40);
      ctx.fillStyle = '#38bdf8';
      ctx.font = 'bold 14px sans-serif';
      ctx.fillText(`FLEETGUARD LIVE SNAP | ${new Date().toLocaleTimeString()} | ${currentRider?.vehicle_number || 'VEHICLE'}`, 15, canvas.height - 15);

      const base64Data = canvas.toDataURL('image/jpeg', 0.85);
      capturedPhotos[step.id] = base64Data;

      stopCameraStream();

      // Update Preview UI
      const previewImg = document.getElementById('capturedImgPreview');
      previewImg.src = base64Data;
      previewImg.classList.remove('hidden');
      document.getElementById('cameraPlaceholder').classList.add('hidden');

      // Auto Advance if not last step
      if (currentStepIndex < PHOTO_STEPS.length - 1) {
        selectStepIndex(currentStepIndex + 1);
      } else {
        updateStepProgressUI();
      }
    }

    function selectStepIndex(idx) {
      currentStepIndex = idx;
      const step = PHOTO_STEPS[idx];

      document.getElementById('currentStepTitle').textContent = step.label;
      document.getElementById('currentStepDesc').textContent = step.desc;
      document.getElementById('overlayLabel').textContent = `ALIGN: ${step.label}`;

      const previewImg = document.getElementById('capturedImgPreview');
      const placeholder = document.getElementById('cameraPlaceholder');

      stopCameraStream();

      if (capturedPhotos[step.id]) {
        previewImg.src = capturedPhotos[step.id];
        previewImg.classList.remove('hidden');
        placeholder.classList.add('hidden');
        document.getElementById('startCamBtnText').textContent = 'Retake Live Photo';
      } else {
        previewImg.classList.add('hidden');
        placeholder.classList.remove('hidden');
        document.getElementById('startCamBtnText').textContent = 'Activate Camera';
      }

      updateStepProgressUI();
    }

    function updateStepProgressUI() {
      PHOTO_STEPS.forEach((step, idx) => {
        const thumb = document.getElementById(`photoThumb_${idx}`);
        const isCaptured = !!capturedPhotos[step.id];
        const isCurrent = currentStepIndex === idx;

        if (isCaptured) {
          thumb.className = "relative aspect-square rounded-xl border border-emerald-500 bg-emerald-950/40 flex flex-col items-center justify-center p-1 text-center transition-all overflow-hidden";
          thumb.innerHTML = `
            <img src="${capturedPhotos[step.id]}" class="w-full h-full object-cover rounded-lg" />
            <span class="absolute inset-0 bg-slate-950/40 flex items-center justify-center">
              <i data-lucide="check" class="w-4 h-4 text-emerald-400"></i>
            </span>
          `;
        } else if (isCurrent) {
          thumb.className = "relative aspect-square rounded-xl border border-sky-500 bg-sky-950/50 flex flex-col items-center justify-center p-1 text-center transition-all overflow-hidden ring-2 ring-sky-500/40";
          thumb.innerHTML = `
            <i data-lucide="camera" class="w-4 h-4 text-sky-400"></i>
            <span class="text-[9px] font-semibold mt-1 text-slate-300 truncate w-full">${idx + 1}. ${step.id}</span>
          `;
        } else {
          thumb.className = "relative aspect-square rounded-xl border border-slate-800 bg-slate-950 opacity-50 flex flex-col items-center justify-center p-1 text-center transition-all overflow-hidden";
          thumb.innerHTML = `
            <i data-lucide="camera" class="w-4 h-4 text-slate-500"></i>
            <span class="text-[9px] font-semibold mt-1 text-slate-400 truncate w-full">${idx + 1}. ${step.id}</span>
          `;
        }
      });

      lucide.createIcons();
      const count = Object.keys(capturedPhotos).length;
      document.getElementById('photoCountBadge').textContent = `${count} / 5 Snaps`;
      validateSubmitButton();
    }

    function validateSubmitButton() {
      const submitBtn = document.getElementById('submitInspectionBtn');
      const photoCount = Object.keys(capturedPhotos).length;

      let validReason = true;
      if (selectedStatus !== 'Working/Active') {
        const selectVal = document.getElementById('returnReasonSelect').value;
        if (!selectVal) validReason = false;
        if (selectVal === 'Other Reason' && !document.getElementById('customReasonText').value.trim()) validReason = false;
      }

      if (currentRider && photoCount === 5 && validReason) {
        submitBtn.disabled = false;
        submitBtn.className = "w-full py-4 rounded-2xl font-black text-xs uppercase tracking-wider transition-all flex items-center justify-center space-x-2 shadow-2xl bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer shadow-emerald-600/20";
      } else {
        submitBtn.disabled = true;
        submitBtn.className = "w-full py-4 rounded-2xl font-black text-xs uppercase tracking-wider transition-all flex items-center justify-center space-x-2 shadow-2xl bg-slate-800 text-slate-500 cursor-not-allowed border border-slate-700";
      }
    }

    // -------------------------------------------------------------------------
    // 6. FORM SUBMISSION (SUPABASE OR LOCAL)
    // -------------------------------------------------------------------------
    async function handleInspectionSubmit(e) {
      e.preventDefault();
      if (!currentRider) return;

      const submitBtn = document.getElementById('submitInspectionBtn');
      submitBtn.disabled = true;
      submitBtn.textContent = "Uploading & Saving Telemetry...";

      const reasonSelect = document.getElementById('returnReasonSelect').value;
      const customText = document.getElementById('customReasonText').value;
      const finalReason = selectedStatus === 'Working/Active' 
        ? 'N/A - Active Shift' 
        : (reasonSelect === 'Other Reason' ? customText : reasonSelect);

      const dateStr = new Date().toISOString().split('T')[0];

      let photoUrls = { ...capturedPhotos };

      // Upload photos to Supabase Storage if configured
      if (supabaseClient) {
        try {
          for (const [angle, base64] of Object.entries(capturedPhotos)) {
            // Convert base64 to Blob
            const blob = await (await fetch(base64)).blob();
            const filePath = `${dateStr}/${currentRider.phone}_${angle}_${Date.now()}.jpg`;

            const { data, error } = await supabaseClient.storage
              .from('inspection-photos')
              .upload(filePath, blob, { contentType: 'image/jpeg', upsert: true });

            if (!error) {
              const { data: publicUrlData } = supabaseClient.storage
                .from('inspection-photos')
                .getPublicUrl(filePath);
              photoUrls[angle] = publicUrlData.publicUrl;
            }
          }

          // Insert DB Record
          await supabaseClient.from('daily_inspections').insert([{
            rider_phone: currentRider.phone,
            rider_name: currentRider.rider_name,
            vehicle_number: currentRider.vehicle_number,
            status: selectedStatus,
            return_reason: finalReason,
            selfie_url: photoUrls.selfie || '',
            front_url: photoUrls.front || '',
            back_url: photoUrls.back || '',
            left_url: photoUrls.left || '',
            right_url: photoUrls.right || '',
            inspection_date: dateStr
          }]);

        } catch (err) {
          console.error("Supabase insert error, falling back to local state", err);
        }
      }

      // Local fallback state append
      const newRecord = {
        id: 'INS-' + Date.now().toString().slice(-4),
        rider_name: currentRider.rider_name,
        phone: currentRider.phone,
        vehicle_number: currentRider.vehicle_number,
        status: selectedStatus,
        return_reason: finalReason,
        photos: photoUrls,
        created_at: new Date().toISOString()
      };
      localInspections.unshift(newRecord);

      // Show Success Card
      document.getElementById('riderFormCard').classList.add('hidden');
      document.getElementById('riderSuccessCard').classList.remove('hidden');
      document.getElementById('successRiderSubtext').textContent = `Logged for ${currentRider.rider_name} (${currentRider.vehicle_number})`;
      document.getElementById('successStatusVal').textContent = selectedStatus;

      if (selectedStatus !== 'Working/Active') {
        document.getElementById('successReasonRow').classList.remove('hidden');
        document.getElementById('successReasonVal').textContent = finalReason;
      } else {
        document.getElementById('successReasonRow').classList.add('hidden');
      }
    }

    function resetRiderForm() {
      capturedPhotos = {};
      currentStepIndex = 0;
      selectedStatus = 'Working/Active';
      currentRider = null;

      document.getElementById('riderPhoneInput').value = '';
      document.getElementById('customReasonText').value = '';
      document.getElementById('returnReasonSelect').value = '';

      document.getElementById('riderFormCard').classList.remove('hidden');
      document.getElementById('riderSuccessCard').classList.add('hidden');

      lookupRiderByPhone('');
      setStatus('Working/Active');
      selectStepIndex(0);
    }

    // -------------------------------------------------------------------------
    // 7. TEAM LEAD (TL) ROSTER & INSPECTION AUDIT
    // -------------------------------------------------------------------------
    async function fetchRidersFromSupabase() {
      if (!supabaseClient) return;
      const { data, error } = await supabaseClient.from('riders').select('*');
      if (!error && data) {
        localRiders = data;
        renderRosterTable();
      }
    }

    async function fetchInspectionsFromSupabase() {
      if (!supabaseClient) return;
      const { data, error } = await supabaseClient.from('daily_inspections').select('*').order('created_at', { ascending: false });
      if (!error && data) {
        localInspections = data;
        renderInspectionLogs();
      }
    }

    async function handleOnboardRider(e) {
      e.preventDefault();
      const name = document.getElementById('onboardName').value.trim();
      const phone = document.getElementById('onboardPhone').value.trim();
      const vehicle = document.getElementById('onboardVehicle').value.trim().toUpperCase();
      const hub = document.getElementById('onboardHub').value;

      if (!name || !phone || !vehicle) return;

      const newRider = { rider_name: name, phone, vehicle_number: vehicle, hub };

      if (supabaseClient) {
        try {
          const { data, error } = await supabaseClient.from('riders').insert([newRider]).select();
          if (error) throw error;
          alert(`Rider ${name} deployed successfully to Supabase!`);
        } catch (err) {
          alert("Error onboarding rider: " + err.message);
        }
      } else {
        localRiders.unshift({ id: Date.now().toString(), ...newRider });
        alert(`Rider ${name} deployed (Demo Mode)!`);
      }

      document.getElementById('onboardName').value = '';
      document.getElementById('onboardPhone').value = '';
      document.getElementById('onboardVehicle').value = '';

      renderRosterTable();
    }

    function renderRosterTable() {
      const tbody = document.getElementById('rosterTableBody');
      const search = document.getElementById('rosterSearchInput').value.toLowerCase();

      const filtered = localRiders.filter(r => 
        r.rider_name.toLowerCase().includes(search) ||
        r.phone.includes(search) ||
        r.vehicle_number.toLowerCase().includes(search)
      );

      document.getElementById('statTotalRiders').textContent = localRiders.length;

      tbody.innerHTML = filtered.map(r => `
        <tr class="hover:bg-slate-800/40">
          <td class="p-2.5 font-bold text-white">${r.rider_name}</td>
          <td class="p-2.5 font-mono text-slate-400">${r.phone}</td>
          <td class="p-2.5 font-mono text-sky-400 font-bold">${r.vehicle_number}</td>
          <td class="p-2.5 text-slate-400">${r.hub || 'N/A'}</td>
          <td class="p-2.5">
            <button onclick="removeRider('${r.phone}')" class="text-rose-400 hover:underline text-[11px]">Unmap</button>
          </td>
        </tr>
      `).join('');

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-500">No riders mapped yet.</td></tr>`;
      }
    }

    async function removeRider(phone) {
      if (!confirm("Unmap this rider from system?")) return;

      if (supabaseClient) {
        await supabaseClient.from('riders').delete().eq('phone', phone);
      }
      localRiders = localRiders.filter(r => r.phone !== phone);
      renderRosterTable();
    }

    function renderInspectionLogs() {
      const container = document.getElementById('inspectionLogsContainer');

      const activeCount = localInspections.filter(i => i.status === 'Working/Active').length;
      const breakdownCount = localInspections.filter(i => i.status === 'Breakdown').length;
      const idleCount = localInspections.filter(i => i.status === 'Returned/Idle' || i.status === 'Servicing').length;

      document.getElementById('statActiveToday').textContent = activeCount;
      document.getElementById('statBreakdowns').textContent = breakdownCount;
      document.getElementById('statIdle').textContent = idleCount;

      if (localInspections.length === 0) {
        container.innerHTML = `<div class="p-8 text-center text-slate-500 text-xs">No daily inspection reports submitted yet today.</div>`;
        return;
      }

      container.innerHTML = localInspections.map(ins => {
        const isWorking = ins.status === 'Working/Active';
        const badgeColor = isWorking 
          ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' 
          : ins.status === 'Breakdown'
          ? 'bg-rose-500/10 text-rose-400 border-rose-500/30'
          : 'bg-amber-500/10 text-amber-400 border-amber-500/30';

        const photos = ins.photos || {
          selfie: ins.selfie_url,
          front: ins.front_url,
          back: ins.back_url,
          left: ins.left_url,
          right: ins.right_url
        };

        return `
          <div class="p-4 bg-slate-950 border border-slate-800 rounded-2xl space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-sm font-bold text-white">${ins.rider_name}</span>
                <span class="text-xs text-slate-400 font-mono ml-2">(${ins.phone || ins.rider_phone})</span>
              </div>
              <span class="px-2.5 py-1 text-xs font-bold rounded-full border ${badgeColor}">
                ${ins.status}
              </span>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-2 text-xs bg-slate-900 p-2.5 rounded-xl border border-slate-800">
              <div>
                <span class="text-slate-500 text-[10px] block">VEHICLE PLATE</span>
                <span class="font-mono font-bold text-sky-400">${ins.vehicle_number}</span>
              </div>
              <div>
                <span class="text-slate-500 text-[10px] block">TIME</span>
                <span class="font-mono text-slate-300">${new Date(ins.created_at || Date.now()).toLocaleTimeString()}</span>
              </div>
              <div class="col-span-2 md:col-span-1">
                <span class="text-slate-500 text-[10px] block">REASON</span>
                <span class="text-amber-300 font-semibold truncate block">${ins.return_reason || 'N/A'}</span>
              </div>
            </div>

            <!-- 5 Angle Image Grid -->
            <div class="grid grid-cols-5 gap-1.5 pt-1">
              ${['selfie', 'front', 'back', 'left', 'right'].map(angle => `
                <div class="aspect-square bg-slate-900 border border-slate-800 rounded-lg overflow-hidden relative">
                  ${photos[angle] ? `<img src="${photos[angle]}" class="w-full h-full object-cover" />` : `<div class="w-full h-full flex items-center justify-center text-[9px] text-slate-600">N/A</div>`}
                  <span class="absolute bottom-0 inset-x-0 bg-slate-950/80 text-[8px] text-slate-300 text-center py-0.5 uppercase font-mono">${angle}</span>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }).join('');
    }
  </script>
</body>
</html>